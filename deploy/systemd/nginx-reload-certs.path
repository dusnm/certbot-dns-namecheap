# Reload host nginx whenever certbot (running in Docker) replaces the
# example.com certificate. certbot updates the symlinks in live/<name>/
# last, after all new files are in archive/, so the live dir is watched.
[Unit]
Description=Watch the example.com Let's Encrypt certificate for changes

[Path]
PathChanged=/etc/letsencrypt/live/example.com
Unit=nginx-reload-certs.service

[Install]
WantedBy=multi-user.target
