# Copy to .env (git-ignored). docker-compose substitutes these into docker-compose.yml.
# Namecheap: Profile > Tools > Business & Dev Tools > API Access (enable it, whitelist your IP).
NAMECHEAP_API_USER=your-namecheap-user
NAMECHEAP_API_KEY=your-namecheap-api-key
NAMECHEAP_CLIENT_IP=203.0.113.10
CERTBOT_EMAIL=you@example.com
# ";" separates certificates, "," separates names within one certificate
CERTBOT_CERTS=example.com,*.example.com
# true = Let's Encrypt staging (untrusted test certificates); set false once it works
CERTBOT_STAGING=true
